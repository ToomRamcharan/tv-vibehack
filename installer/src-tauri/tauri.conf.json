{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NLRC Setup",
  "version": "0.1.0",
  "identifier": "com.gathin.tvhome.setup",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "NLRC Setup", "width": 900, "height": 640 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "signingIdentity": "-" }
  }
}
