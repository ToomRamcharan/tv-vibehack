<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070A10">

    <!-- 1. Background Wallpaper with dark cinematic scrim -->
    <ImageView
        android:id="@+id/bgWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_home" />

    <!-- 2. Dark vignette gradient -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#5907090E" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="32dp"
        android:paddingBottom="24dp">

        <!-- Header Row with Logo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/logo_pendrive_viewer" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
    android:fontFamily="@font/outfit"
                    android:id="@+id/tvHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pd_title"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:fontVariationSettings="'wght' 700"
    android:textStyle="bold"
                    android:shadowColor="#80000000"
                    android:shadowRadius="6" />

                <TextView
    android:fontFamily="@font/outfit"
                    android:id="@+id/tvHeaderSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/pd_subtitle"
                    android:textColor="#FFF59D"
                    android:textSize="17sp"
                    android:fontVariationSettings="'wght' 700"
    android:textStyle="bold" />
            </LinearLayout>

            <!-- Storage Status Pill -->
            <TextView
    android:fontFamily="@font/outfit"
                android:id="@+id/tvUsbStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_pill"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontVariationSettings="'wght' 700"
    android:textStyle="bold" />
        </LinearLayout>

        <!-- Videos found on TV storage and USB drives (filled by PenDriveActivity) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/videoList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <TextView
    android:fontFamily="@font/outfit"
                android:id="@+id/emptyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                android:textColor="#E2E8F0"
                android:textSize="22sp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
    android:fontFamily="@font/outfit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/pd_hint"
            android:textColor="#E2E8F0"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
