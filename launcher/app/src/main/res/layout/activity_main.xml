<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Divine Shiva and Parvathi Wallpaper Background -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_shiva_parvathi" />

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Top shelf: the focused dock app's name, positioned above the dock in code. -->
    <TextView
        android:id="@+id/heroName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="68dp"
        android:alpha="0"
        android:textColor="#FFFFFFFF"
        android:textSize="48sp"
        style="@style/FontOutfitW400"
        android:letterSpacing="-0.02"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:shadowColor="#CC000000"
        android:shadowDx="2"
        android:shadowDy="4"
        android:shadowRadius="10" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="22dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Left: NLRC Logo + Clock + Date -->
            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="vertical">

                <!-- NLRC Brand Name — Bold 3D Metallic White with Layered Shadow -->
                <TextView
                    android:id="@+id/greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NLRC"
                    android:textColor="#FFFFFFFF"
                    android:textSize="36sp"
                    style="@style/FontOutfitW900"
                    android:letterSpacing="0.10"
                    android:includeFontPadding="false"
                    android:shadowColor="#D9000000"
                    android:shadowDx="3"
                    android:shadowDy="6"
                    android:shadowRadius="12" />

                <!-- Founder and Subtitle Row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="3dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ENTERTAINMENT HUB"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp"
                        style="@style/FontOutfitW700"
                        android:letterSpacing="0.12"
                        android:textAllCaps="true"
                        android:shadowColor="#B3000000"
                        android:shadowDx="1"
                        android:shadowDy="3"
                        android:shadowRadius="6" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:background="#44FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ENTERTAINMENT HUB"
                        android:textColor="#B3FFFFFF"
                        android:textSize="11sp"
                        style="@style/FontOutfitW500"
                        android:letterSpacing="0.16"
                        android:textAllCaps="true" />
                </LinearLayout>

                <!-- Father's Greeting: Time-based Respectful Telugu Wish -->
                <TextView
                    android:id="@+id/fatherGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="శుభ మధ్యాహ్నం తూం నారాయణ గారు! 🙏"
                    android:textColor="#FFF59D"
                    android:textSize="17sp"
                    style="@style/FontOutfitW700"
                    android:letterSpacing="0.02"
                    android:layout_marginTop="5dp"
                    android:shadowColor="#E6000000"
                    android:shadowDx="2"
                    android:shadowDy="3"
                    android:shadowRadius="6" />

                <!-- Clock row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="true"
                    android:layout_marginTop="6dp">

                    <TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="#FFFFFFFF"
                        android:textSize="46sp"
                        style="@style/FontOutfitW200"
                        android:letterSpacing="-0.04"
                        android:includeFontPadding="false"
                        android:shadowColor="#B3000000"
                        android:shadowDx="2"
                        android:shadowDy="4"
                        android:shadowRadius="8" />

                    <TextClock
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="7dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textColor="#B3FFFFFF"
                        android:textSize="13sp"
                        style="@style/FontOutfitW500"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true" />

                    <!-- Slim subtle white divider -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="20dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="14dp"
                        android:layout_marginBottom="8dp"
                        android:background="#2EFFFFFF" />

                    <TextClock
                        android:id="@+id/date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="8dp"
                        android:format12Hour="EEEE  d MMMM"
                        android:format24Hour="EEEE  d MMMM"
                        android:textColor="#99FFFFFF"
                        android:textSize="13sp"
                        style="@style/FontOutfitW400"
                        android:letterSpacing="0.12"
                        android:textAllCaps="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- Right: frosted pill buttons -->
            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignBottom="@id/leftBlock"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopButton"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopButton"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/TopButton"
                    android:text="@string/settings"
                    android:drawableStart="@drawable/ic_settings"
                    android:nextFocusDown="@+id/grid" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Telangana Festival Wishes Banner (Dynamic) -->
        <LinearLayout
            android:id="@+id/festivalBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_festival_pill"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/festivalText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌸 సద్దుల బతుకమ్మ &amp; విజయదశమి దసరా శుభాకాంక్షలు · Happy Bathukamma &amp; Dussehra! 🌸"
                android:textColor="#FFF9C4"
                android:textSize="12sp"
                style="@style/FontOutfitW600"
                android:letterSpacing="0.04"
                android:shadowColor="#E6000000"
                android:shadowDx="1"
                android:shadowDy="2"
                android:shadowRadius="4" />
        </LinearLayout>

        <!-- Subtle clean divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#15FFFFFF" />

        <!-- App Grid -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

    <!-- The single floating glass highlight that springs between tiles. -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />

</FrameLayout>
