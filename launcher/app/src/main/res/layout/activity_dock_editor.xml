<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0A0C12"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="30dp"
        android:paddingBottom="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 800"
            android:includeFontPadding="false"
            android:letterSpacing="-0.01"
            android:shadowColor="#A6000000"
            android:shadowDx="1"
            android:shadowDy="3"
            android:shadowRadius="6"
            android:text="@string/edit_dock"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500"
            android:text="@string/dock_hint"
            android:textColor="#9AFFFFFF"
            android:textSize="13sp" />

        <!-- Pinned section, dressed like the dock band on Home. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 700"
            android:letterSpacing="0.14"
            android:text="@string/pinned_section"
            android:textAllCaps="true"
            android:textColor="#7AFFFFFF"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/dockRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 700"
            android:letterSpacing="0.14"
            android:text="@string/all_apps_section"
            android:textAllCaps="true"
            android:textColor="#7AFFFFFF"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/appRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
