<?xml version="1.0" encoding="utf-8"?>
<!-- One video in the PenDrive Viewer row: real thumbnail, file name, duration · source. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/videoCard"
    android:layout_width="320dp"
    android:layout_height="210dp"
    android:layout_marginEnd="20dp"
    android:background="@drawable/bg_media_card"
    android:clickable="true"
    android:focusable="true"
    android:padding="3dp">

    <ImageView
        android:id="@+id/videoThumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_thumb_card" />

    <View
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_card_bottom_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
    android:fontFamily="@font/outfit"
            android:id="@+id/videoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:fontVariationSettings="'wght' 700"
    android:textStyle="bold" />

        <TextView
    android:fontFamily="@font/outfit"
            android:id="@+id/videoInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#E2E8F0"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
