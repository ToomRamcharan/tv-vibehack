<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Apps pinned to the dock row at the bottom, in this order. Slot 0 is HDMI 2 (Jio TV). -->
    <string-array name="dock_apps">
        <item>hdmi_2</item>
        <item>nlrc_pendrive</item>
        <item>in.startv.hotstar</item>
        <item>ahaflix.tv</item>
    </string-array>

    <!-- Apps never shown as tiles (Live TV is reachable via the Inputs menu instead). -->
    <string-array name="hidden_apps">
        <item>com.realtek.tv</item>
        <item>com.realtek.dtv</item>
        <item>com.realtek.dtmb</item>
        <item>com.realtek.tv.atsc</item>
        <item>com.realtek.tv.atv</item>
        <item>com.realtek.tv.isdb</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. -->
    <string name="live_tv_package" translatable="false">com.realtek.tv</string>

    <!-- Optional explicit vendor input chooser. Empty values retain the TIF picker. -->
    <string name="native_input_picker_action" translatable="false"></string>
    <string name="native_input_picker_receiver" translatable="false"></string>

    <!-- Tiles per row in the grid; the dock always has this many slots. -->
    <integer name="columns">4</integer>

</resources>
